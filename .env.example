# Copy to .env.local for local development. Existing .env is never loaded implicitly.
# Generate MASTER_SECRET using make init-dev; never commit it.
MASTER_SECRET=
DATABASE_PATH=data/app.sqlite3
PUBLIC_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# Codex is currently disabled pending verified runtime isolation. No paid fallback.
LLM_PROVIDER=codex
LLM_MODEL=
OPENROUTER_API_KEY=
BACKEND_URL=http://localhost:8000
