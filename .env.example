# Copy to .env.local for local development. Existing .env is never loaded implicitly.
# All application flags/settings are listed here; backend types/defaults live in
# backend/app/core/config.py. Restart the backend after changing these settings.
# make init-dev copies this template and generates private values; never commit them.

# Storage, authentication and browser boundary.
MASTER_SECRET=
MASTER_SECRET_PREVIOUS=[]
DATABASE_PATH=data/app.sqlite3
PUBLIC_ORIGIN=http://localhost:3002
COOKIE_SECURE=false
SESSION_DAYS=7
# Public demo: close sign-ups and provision the shared test account on startup.
REGISTRATION_ENABLED=false
TEST_ACCOUNT_ENABLED=true

# Provider selection and explicit local-only Codex opt-in.
# Codex is opt-in and local-only. Run make setup-codex and make codex-login.
LLM_PROVIDER=codex
LLM_MODEL=gpt-6.1-sol
LIVEX_CODEX_ENABLED=1
LIVEX_CODEX_AUTH_HOME=
OPENROUTER_API_KEY=

# Optional Cal.com TLS trust; ambient HTTP proxies are ignored.
# SSL_CERT_FILE=/absolute/path/to/ca-bundle.pem
# SSL_CERT_DIR=/absolute/path/to/ca-directory

# Runner feature flag and per-process/per-run limits.
RUNNER_ENABLED=true
# Concurrent conversations per backend process (1-64); excess runs stay queued.
MAX_CONCURRENT_RUNS=4
MAX_MODEL_STEPS=12
MAX_TOOL_CALLS=24
RUN_TIMEOUT_SECONDS=180

# Estimated token/cost limits, including tool schemas.
# gpt-6.1-sol through Codex: 500K default window, half allowed for input.
# Adjust these for other models/providers; output and safety reserves still apply.
CONTEXT_WINDOW_TOKENS=500000
CONTEXT_INPUT_TOKENS=250000
CONTEXT_OUTPUT_TOKENS=4096
CONTEXT_SAFETY_TOKENS=1024
CONTEXT_TOOL_RESULT_TOKENS=2500
CONTEXT_TOOL_RESERVE_TOKENS=1024
CONTEXT_BYTES_PER_TOKEN=2.0
CONTEXT_COMPACTION_THRESHOLD=0.7
CONTEXT_INTENT_TOKENS=1600
CONTEXT_SUMMARY_TOKENS=1200
CONTEXT_RETRIEVAL_TOKENS=1600

# Local owner-scoped diagnostics; disabled by default.
DEBUG_API=false
TRACE_MAX_BYTES=16000

# Frontend development/build settings (not exposed to browser JavaScript).
FRONTEND_PORT=3002
BACKEND_URL=http://localhost:8000

# Only proxy peers that overwrite X-Real-IP; forwarded headers are ignored otherwise.
TRUSTED_INGRESS_CIDRS=[]

# Preserve the direct transport peer for application-managed ingress validation.
FORWARDED_ALLOW_IPS=
